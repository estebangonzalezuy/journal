# --- Telegram ---------------------------------------------------------------
# Token que te da @BotFather con /newbot
TELEGRAM_BOT_TOKEN=
# Cadena random que inventás vos (ej: openssl rand -hex 32). Telegram la manda
# en cada request y el webhook rechaza lo que no la traiga.
TELEGRAM_WEBHOOK_SECRET=
# Tu chat id. Escribile al bot y corré:
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
TELEGRAM_ALLOWED_CHAT_ID=

# --- Transcripción y redacción ----------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Opcional. Por defecto claude-opus-5.
ANTHROPIC_MODEL=

# --- Notion -----------------------------------------------------------------
# Token de la integration (notion.so/my-integrations)
NOTION_TOKEN=
# Id de la página "Journal" (el hash del final de la URL, sin guiones)
NOTION_JOURNAL_PAGE_ID=
# Id de la base de datos "Tareas"
NOTION_TASKS_DATABASE_ID=
# Opcional: tu user id de Notion, para completar Assignee en las tareas.
NOTION_ASSIGNEE_USER_ID=
# Opcional: nombre exacto de la opción de Status inicial (ej "Not started").
# Si lo dejás vacío, la tarea se crea con el default de la base.
NOTION_TASK_STATUS=

# --- Mail -------------------------------------------------------------------
RESEND_API_KEY=
SUMMARY_EMAIL_TO=
# Con dominio propio verificado en Resend; si no, dejá el default.
SUMMARY_EMAIL_FROM=Journal Bot <onboarding@resend.dev>

# --- Varios -----------------------------------------------------------------
# Protege los endpoints de cron. Vercel lo manda solo si la variable existe.
CRON_SECRET=
# Zona horaria para los títulos "D/M" y las horas. Default Europe/Madrid.
TIMEZONE=Europe/Madrid
