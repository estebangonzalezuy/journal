# --- Telegram -------------------------------------------------------------
# Token que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=
# Cadena aleatoria inventada por vos. Telegram la manda en cada request y el
# webhook rechaza lo que no la traiga. Generala con: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Tu chat id (opcional pero recomendado): solo ese chat puede usar el bot.
# Para saberlo: escribile al bot y mirá los logs, o usá @userinfobot.
TELEGRAM_CHAT_ID=

# --- Transcripción (Whisper) ----------------------------------------------
OPENAI_API_KEY=
# Opcional. Por defecto whisper-1.
OPENAI_TRANSCRIBE_MODEL=

# --- Claude ----------------------------------------------------------------
ANTHROPIC_API_KEY=
# Opcional. Por defecto claude-opus-5.
CLAUDE_MODEL=

# --- Notion ----------------------------------------------------------------
# Internal Integration Secret (empieza con ntn_ o secret_).
NOTION_TOKEN=
# ID de la página "Journal" (la que contiene las subpáginas D/M).
NOTION_JOURNAL_PAGE_ID=
# ID de la base de datos "Tareas".
NOTION_TASKS_DB_ID=
# Opcional: user id de Notion para rellenar la propiedad Assignee.
NOTION_ASSIGNEE_USER_ID=
# Opcional: estado inicial de las tareas creadas. Por defecto "To Do".
NOTION_TASK_STATUS=

# --- Mail (Resend) ---------------------------------------------------------
RESEND_API_KEY=
# Debe ser un dominio verificado en Resend, o onboarding@resend.dev para probar.
SUMMARY_EMAIL_FROM=Journal <journal@tu-dominio.com>
SUMMARY_EMAIL_TO=hey@estebangonzalez.co

# --- Crons -----------------------------------------------------------------
# Vercel lo manda como "Authorization: Bearer $CRON_SECRET".
# Generalo con: openssl rand -hex 32
CRON_SECRET=

# --- General ---------------------------------------------------------------
# Opcional. Por defecto Europe/Madrid.
TIMEZONE=
